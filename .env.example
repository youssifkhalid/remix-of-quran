# ===================================================
# سكينة — Environment Variables
# ===================================================
# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية
# لا ترفع .env.local إلى Git

# Gemini API Key — مطلوب لميزة المساعد الإسلامي AI
# احصل على المفتاح من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# اختياري: Supabase (لحسابات المستخدمين والمزامنة مستقبلاً)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
